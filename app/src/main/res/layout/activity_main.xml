<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020A04"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:text="Enova Launcher v1.1"
        android:textColor="#00FF41"
        android:textSize="18sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <com.enova.launcher.RobotView
        android:id="@+id/robot"
        android:layout_width="match_parent"
        android:layout_height="190dp" />

    <TextView
        android:id="@+id/say"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="28dp"
        android:padding="4dp"
        android:textColor="#FFB454"
        android:typeface="monospace" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="#B9F5C8"
            android:textSize="14sp"
            android:typeface="monospace" />
    </ScrollView>

    <EditText
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#04120A"
        android:hint="enova@home:~$ ls"
        android:imeOptions="actionSend"
        android:inputType="text|textNoSuggestions"
        android:maxLines="1"
        android:padding="14dp"
        android:textColor="#B9F5C8"
        android:textColorHint="#4F7A5B"
        android:typeface="monospace" />
</LinearLayout>
